apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "hello-k8s.fullname" . }}
  labels:
    app.kubernetes.io/name: {{ include "hello-k8s.name" . }}
spec:
  replicas: {{ .Values.replicaCount }}
  selector:
    matchLabels:
      app: {{ include "hello-k8s.name" . }}
  template:
    metadata:
      labels:
        app: {{ include "hello-k8s.name" . }}
    spec:
      containers:
        - name: hello
          image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
          ports:
            - containerPort: 80
