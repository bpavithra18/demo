name: CI

on:
  push:
    branches:
      - main
  pull_request:

jobs:
  lint-helm:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Helm
        uses: azure/setup-helm@v3
      - name: Helm lint
        run: |
          helm lint helm-charts/hello-k8s

  validate-yaml:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate k8s YAML
        uses: instrumenta/kubeval-action@v2
        with:
          files: |
            k8s/*.yaml
            argo-apps/*.yaml
  
